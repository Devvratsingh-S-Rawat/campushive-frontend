# Points at the live backend by default in code — this override is only
# needed if you want to run against a different backend (e.g. local dev).
VITE_API_URL=https://campushive-x3r5.onrender.com

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Same client ID goes in the backend's GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Cloudinary dashboard → Cloud name, and Settings → Upload → an Unsigned preset
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_name
